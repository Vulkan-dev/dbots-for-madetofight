# ─── REQUIRED — Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://ivfctgsvspqavhxexftr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── REQUIRED — Node Identity ─────────────────────────────────────────────────
# Unique ID for this Railway deployment. Change this for each service you deploy.
# Examples: node-1, node-2, backend-main, backend-friend
NODE_ID=node-1

# Human-readable name shown in dashboard
NODE_NAME=Main Service

# Your name (for display in frontend)
NODE_OWNER=Your Name

# The public URL of this Railway service (Railway sets RAILWAY_STATIC_URL automatically)
# You can also set this manually after your first Railway deploy
# NODE_URL=https://donut-bots-production-xxxx.up.railway.app

# ─── REQUIRED — Minecraft Server ─────────────────────────────────────────────
SERVER_HOST=donutsmp.net
SERVER_PORT=19132
OFFLINE_MODE=false

# ─── REQUIRED — Frontend CORS ────────────────────────────────────────────────
# URL of your Vercel frontend — required for CORS to work
FRONTEND_URL=https://your-frontend.vercel.app

# ─── OPTIONAL — API Security ─────────────────────────────────────────────────
# Set a shared secret to secure your Railway API endpoints
# The Vercel frontend must send this as: X-Api-Secret: <value>
# Leave empty to disable security (not recommended for production)
API_SECRET=

# ─── OPTIONAL — Discord Bot (only on the master node) ────────────────────────
# Set DISCORD_MASTER=true on ONE node only (your main service)
# All other nodes: DISCORD_MASTER=false (or omit entirely)
DISCORD_MASTER=true
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_BOT_CATEGORY_ID=
DISCORD_ALLOWED_USER_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_JOIN_LOG_CHANNEL_ID=
DISCORD_LEFT_LOG_CHANNEL_ID=

# ─── OPTIONAL — AFK Settings ─────────────────────────────────────────────────
AFK_ENABLED=true
AFK_ACTIVITY_INTERVAL_MS=5000
AFK_CHECK_INTERVAL_MS=300000
AFK_LOCATION_TOLERANCE=3.0

# ─── OPTIONAL — Combat ───────────────────────────────────────────────────────
DEFENSIVE_COMBAT_ENABLED=false
DEFENSIVE_COMBAT_RANGE=4.5
PLAYER_HIT_RESPONSE_ENABLED=false
PLAYER_HIT_RESPONSE_CROUCH_COUNT=2

# ─── OPTIONAL — Join Scheduler ───────────────────────────────────────────────
JOIN_SCHEDULER_MIN_DELAY_MS=1000
JOIN_SCHEDULER_MAX_DELAY_MS=2000

# ─── OPTIONAL — Misc ─────────────────────────────────────────────────────────
WATCHDOG_RECONNECT_DELAY_MS=1000
FLOODGATE_PREFIX=.

# PORT is set automatically by Railway — do not set it manually
